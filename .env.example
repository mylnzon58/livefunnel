# ==============================================================
# LiveFunnel · Configuración de Entorno
# Copiá este archivo a .env.local y completá con tus credenciales.
# ==============================================================

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta

# Mapbox (Opcional)
# Si no tenés token, LiveFunnel activa automáticamente su globo 3D autónomo en Canvas sin costo.
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/light-v11

# Clave para autorizar endpoints protegidos y limpieza
LIVEFUNNEL_ADMIN_KEY=clave-secreta-administrador
